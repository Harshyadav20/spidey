DATABASE_URL=file:/home/z/my-project/db/custom.db

# -- Gemini API (real Google Gemini API key) -----------------------------
# Used by the Python mini-service (mini-services/gemini-service/main.py).
# In production this returns real Gemini responses. In sandbox/dev regions
# where the Gemini API is geo-restricted, the service falls back gracefully.
GEMINI_API_KEY=AQ.Ab8RN6KqZDUpl0Iu3GWdutw0yG_ihpQ-4Kn_ebY7JIRh8aJJog
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SERVICE_PORT=5001

# -- Gemini service URL (used by Next.js /api/chat proxy) -----------------
# When set, the Next.js /api/chat route proxies chat completions to this
# Python service instead of calling z-ai-web-dev-sdk directly.
GEMINI_SERVICE_URL=http://127.0.0.1:5001

# -- OpenAI-compatible API (fallback LLM after Gemini) -------------------
# Works with any OpenAI-compatible provider: OpenAI, DeepSeek, Groq,
# Together AI, Fireworks, Anyscale, Mistral, local Ollama, etc.
# Set the base URL to your provider's /v1 endpoint.
#
# This API key is a DeepSeek key — confirmed by listing models at
# https://api.deepseek.com/v1/models. Models: deepseek-flash, deepseek-v4-pro
# Note: the account has $0 balance, so chat calls return "Insufficient Balance"
# until you top up at https://platform.deepseek.com/usage
#
# Examples of other providers' base URLs:
#   OpenAI:        https://api.openai.com/v1
#   Groq:          https://api.groq.com/openai/v1
#   Together AI:   https://api.together.xyz/v1
#   Mistral:       https://api.mistral.ai/v1
#
OPENAI_COMPATIBLE_API_KEY=sk-dfd4c7460ce84525aa0e9ac752faf158
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_MODEL=deepseek-flash

# -- Vercel deployment flag -----------------------------------------------
# When running on Vercel, set VERCEL_ENV=production. This makes the Next.js
# chat route call the Vercel Python serverless function (/api/chat-ai)
# instead of the local mini-service.
# VERCEL_ENV=production
